{
  "version": 2,
  "builds": [
    {
      "src": "api/config.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/delete-user.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/delete-user",
      "dest": "/api/delete-user.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}